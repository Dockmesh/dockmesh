                      "dial": "10.0.0.6:8080"
                    }
                  ],
                  "load_balancing": {
                    "selection_policy": {
                      "policy": "round_robin"
                    }
                  },
                  "health_checks": {
                    "active": {
                      "uri": "/healthz"
                    }
                  },
                  "flush_interval": -1,
                  "request_buffers": 4194304,
                  "stream_close_delay": 30000000000,
                  "transport": {
                    "protocol": "http",
                    "dial_timeout": 5000000000,
