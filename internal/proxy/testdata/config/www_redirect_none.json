{
  "admin": {
    "listen": "127.0.0.1:2019",
    "origins": [
      "127.0.0.1:2019",
      "localhost:2019"
    ],
    "enforce_origin": true
  },
  "apps": {
    "http": {
      "servers": {
        "dockmesh_http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "www.app.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 301,
                  "headers": {
                    "Location": [
                      "http://app.example.com{http.request.uri}"
                    ]
                  }
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "app.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "10.0.0.5:8080"
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
