{
  "admin": {
    "listen": "unix//run/dockmesh-caddy/admin.sock|0666",
    "origins": [
      "dockmesh-proxy"
    ],
    "enforce_origin": true
  },
  "apps": {
    "http": {
      "metrics": {
        "per_host": true
      },
      "servers": {
        "dockmesh_http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "app.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "10.0.0.5:8080"
                    }
                  ],
                  "headers": {
                    "request": {
                      "set": {
                        "X-Env": [
                          "lab"
                        ],
                        "X-Forwarded-Port": [
                          "80"
                        ]
                      }
                    }
                  }
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
