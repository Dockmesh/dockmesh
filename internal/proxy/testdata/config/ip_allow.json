{
  "admin": {
    "listen": "127.0.0.1:2019",
    "origins": [
      "127.0.0.1:2019",
      "localhost:2019"
    ],
    "enforce_origin": true
  },
  "apps": {
    "http": {
      "servers": {
        "dockmesh": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "app.example.com"
                  ],
                  "not": [
                    {
                      "client_ip": {
                        "ranges": [
                          "192.168.10.0/24",
                          "10.8.0.1/32"
                        ]
                      }
                    }
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 403
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "app.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "10.0.0.5:8080"
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        },
        "dockmesh_http": {
          "listen": [
            ":80"
          ],
          "routes": []
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "subjects": [
              "app.example.com"
            ],
            "issuers": [
              {
                "module": "acme"
              }
            ]
          }
        ]
      }
    }
  }
}
